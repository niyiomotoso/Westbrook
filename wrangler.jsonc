{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "westbrook-wall",
  "account_id": "c1382a9be839dd30d99a0b46faed8b15",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "westbrook-wall"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "westbrook-db",
      "database_id": "6b52dab3-40ca-446e-8773-9d69f833faa3",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "be2e10e84fae4d1d9d9e1f18da1a1277"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "type": "ratelimit",
        "name": "LOGIN_RL",
        "namespace_id": "1001",
        "simple": { "limit": 5, "period": 60 }
      },
      {
        "type": "ratelimit",
        "name": "PUBLIC_RL",
        "namespace_id": "1002",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
